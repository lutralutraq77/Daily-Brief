# --- personal runtime output: never commit ---
briefs/
logs/
cache/
workspace/
state.json

# --- live configuration: ships as .example files instead ---
# calendars.txt holds a Google secret iCal URL, which is a permanent bearer
# token granting read of the whole calendar. It must never be tracked.
calendars.txt
config.json
# plan.json is your own 3x3 plan -- the topics you are learning and the changes
# you are running. Personal, not secret; ships as plan.example.json.
plan.json

# --- local scratch ---
sample-preview.html
tests/render_test.html
*.testbak
*.bak

# --- build artefacts ---
__pycache__/
*.py[cod]
dist/
build/
packaging/android/.gradle/
packaging/android/app/src/main/python/
packaging/arch/*.pkg.tar.zst
packaging/arch/pkg/
packaging/arch/src/

# --- signing: the release key and its password ---
# Lose these and Android will refuse to install an update over the app. They
# are deliberately untracked; back them up somewhere that is not this repo.
*.jks
*.keystore
keystore.properties
packaging/android/local.properties

# --- generated icons (rebuild with: python dailybrief.py icon) ---
icon.png
icon.ico
